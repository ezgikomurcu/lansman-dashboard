# Yerel geliştirme (mevcut lokal Postgres) — DATABASE_URL YOKSA bunlar kullanılır
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=lansman_db

# Neon/Vercel gibi ortamlarda tek parça bağlantı string'i — VARSA yukarıdakilerin
# hepsinin yerine geçer (bkz. backend/db.js). Neon panelinden "Connection string"
# olarak kopyalanır, sonunda ?sslmode=require olması gerekmez, kod SSL'i zaten
# DATABASE_URL varlığına göre otomatik açıyor.
# DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/dbname

JWT_SECRET=
